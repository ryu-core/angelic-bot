# Full dashboard runtime (the public site still starts when these are unset)
MONGODB_URI=mongodb://127.0.0.1:27017/xiel
SESSION_SECRET=replace-with-at-least-32-random-characters

# Discord bot and OAuth application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:10300/api/auth/callback
OWNER_IDS=123456789012345678
CO_OWNER_IDS=
GF_USER_ID=
PREFIX=,

# Dashboard URLs and ports
DASHBOARD_PORT=10300
CLIENT_URL=http://localhost:5173
DASHBOARD_PUBLIC_URL=http://localhost:10300

# Existing Python bot integrations
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
SERPER_API_KEY=
